{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeSchedule",
  "version": "0.1.2",
  "identifier": "com.timeschedule.personal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeSchedule",
        "width": 1160,
        "height": 820,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "backgroundColor": "#f5f6f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
